# MondaiPhi — Question Bank Service
# Copy this file to .env and fill in your values

# Server
MONDAIPHI_PORT=8087
MONDAIPHI_ENVIRONMENT=development

# Database (PostgreSQL)
MONDAIPHI_DATABASE_URL=postgres://phi:phi_dev_password@localhost:5432/mondaiphi?sslmode=disable

# Auth (JWKS from AuthPhi — do NOT include /.well-known/jwks.json)
MONDAIPHI_AUTH_JWKS_URL=http://localhost:8080

# Storage (BiznetGio Neo Cloud S3)
MONDAIPHI_STORAGE_ENDPOINT=nos.wjv-1.neo.id
MONDAIPHI_STORAGE_REGION=us-east-1
MONDAIPHI_STORAGE_BUCKET=philia-space
MONDAIPHI_STORAGE_ACCESS_KEY=your_storage_access_key
MONDAIPHI_STORAGE_SECRET_KEY=your_storage_secret_key
MONDAIPHI_STORAGE_USE_SSL=true
MONDAIPHI_STORAGE_PRESIGN_TTL=1h

# Dashboard Admin Credentials
PHILIA_ADMIN_USERNAME=admin
PHILIA_ADMIN_PASSWORD=change_me

# Service-to-service auth (shared secret between MondaiPhi & ShikenPhi)
MONDAIPHI_SERVICE_SECRET=change_me_in_production
